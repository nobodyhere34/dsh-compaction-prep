{
  "name": "dsh-compaction-prep",
  "version": "0.1.0",
  "description": "compaction-prep-suite: Claude Code pre-Autocompact mechanisms on DSH ACP (billion-context-dsh) as a bypass plugin — L1 trim_tool_results, L2 snip_history, L3/L4 microcompact, acp_rule.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "ARCHITECTURE.md",
    "cordis.patch.yml",
    "scripts"
  ],
  "license": "MIT",
  "private": true,
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "billion-context-dsh": "0.2.27"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "scripts": {
    "test": "bash scripts/test.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nobodyhere34/dsh-compaction-prep.git"
  },
  "homepage": "https://github.com/nobodyhere34/dsh-compaction-prep#readme",
  "bugs": {
    "url": "https://github.com/nobodyhere34/dsh-compaction-prep/issues"
  }
}
